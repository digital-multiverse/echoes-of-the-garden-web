// Cloudflare Workers static assets. The script (src/worker.js) only runs for /api/*; everything else is
// served straight from the assets, with .assetsignore keeping the repo's own files out of the site.
{
  "name": "echoes-of-the-garden",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker.js",
  "assets": {
    "directory": ".",
    "run_worker_first": ["/api/*"]
  },
  // Test phase: workers.dev only. At the cut-over add the custom domains and set workers_dev to false,
  // so search engines get no second copy of the site.
  "workers_dev": true,
  "preview_urls": false
}
