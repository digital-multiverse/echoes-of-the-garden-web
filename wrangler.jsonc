// Cloudflare Workers static assets. The script (src/worker.js) only runs for /api/*; everything else is
// served straight from the assets, with .assetsignore keeping the repo's own files out of the site.
{
  "name": "echoes-of-the-garden",
  // Info@josejpg.com account, with comparavoto. Fixed here because wrangler deploys wherever it is logged in.
  "account_id": "91fe7d6faa0d5d83b5731ce1cbf03151",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker.js",
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Only the root domain: www is a 301 at the edge, not on the Worker. No workers.dev copy for search engines.
  "routes": [{ "pattern": "echoesofthegarden.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
